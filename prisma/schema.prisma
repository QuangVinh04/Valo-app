generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//TODO: Bkav HoannTH: Thống nhất cách đặt tên cột trong DB cùng 1 định dạng: ví dụ: userId, created_at(có thể là userId, createdAt)
//FIXME: Bkav VinhTQ: Done
model User {
  id                 String         @id @default(uuid()) @db.Uuid
  fullName           String
  email              String         @unique
  phoneNumber        String?
  address            String?
  password           String?
  conversations      Conversation[]
  attachments        Attachment[]
  userGroups         UserGroup[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  refreshToken       String?
  active             Boolean        @default(false)
  invitationEmailFailed Boolean        @default(false)
  //TODO: Bkav HoanNTH: không nên để setting default, nên để mặc định null sau đó trả mặc định trong code tránh TH sau thay đổi default phải migration
  //FIXME: Bkav VinhTQ: Done
  settings           Json?

  @@map("users")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String
  modelName String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderType     String        @default("user")
  parentMessageId String
  ancestors      String[]      @default([])
  status         MessageStatus @default(PENDING)
  modelName      String?
  content        String        @db.Text
  isUserStopped  Boolean       @default(false)
  attachments    Attachment[]
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum MessageStatus {
  PENDING
  SUCCESS
  FAILED
}

model Attachment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  messageId     String?  @db.Uuid
  fileName      String
  mimeType      String
  fileUrl       String?
  fileSize      Int?
  extractedText String?
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("conversation_attachments")
}

model Group {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  permissions String[]    @default([])
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userGroups  UserGroup[]

  @@map("group")
}

model UserGroup {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  groupId    String   @db.Uuid
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("user_group")
}
