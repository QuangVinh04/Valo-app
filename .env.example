PORT=4001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
LOG_LEVEL=debug

# Local database and Redis hosts
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=valo_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valo_db?schema=public
REDIS_URL=redis://localhost:6379
POSTGRES_MAX_RETRIES=5
POSTGRES_RETRY_DELAY_MS=3000

# pgAdmin is used only when running Docker Compose
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

JWT_SECRET=change_me_to_a_long_random_secret
JWT_VALID_DURATION=15m
JWT_REFRESH_DURATION=30d

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com

AI_PROVIDER=flowise
FLOWISE_API_KEY=your_flowise_api_key
FLOWISE_BASE_URL=https://aiplatform.bkav.ai
FLOWISE_CHATFLOW_ID=your_flowise_chatflow_id

GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
